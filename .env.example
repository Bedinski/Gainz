# --- Alpaca ---
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
# 'paper' | 'live'
TRADING_MODE=paper
# Required to actually flip live mode on; defense-in-depth against accidents.
LIVE_TRADING_CONFIRMED=

# --- Single-user auth for the bot's mutating API routes ---
BOT_TOKEN=

# --- Cycle scheduling ---
# US/Eastern; default = every 15 min, market hours, weekdays.
CRON_SCHEDULE=*/15 9-16 * * 1-5
CRON_TZ=America/New_York

# --- DB path ---
SQLITE_PATH=./data/gainz.db

# --- Guardrails ---
# Phase-default for the $2-3K cash-account live phase: tight, large-cap, fractional-friendly.
SYMBOL_ALLOWLIST=AAPL,MSFT,GOOGL,NVDA,AMD,META,TSLA,AMZN,SPY,QQQ
MAX_POSITION_USD=400
MAX_ORDER_USD=400
MAX_DAILY_LOSS_USD=60
MAX_TRADES_PER_DAY=4
# Buffer for fees and price moves between proposal and fill (cash-account phase)
RESERVE_SETTLED_CASH_USD=50
# Sum of (technical+congress+news) signal strengths required to trade. Each is 0|1|2.
MIN_SIGNAL_SCORE=3
# Max number of contradicting signals Claude may list. 0 = any conflict kills the trade.
MAX_CONFLICTS=0

# --- Strategy ---
STOP_LOSS_PCT=2.5
STOP_LOSS_MIN_PCT=1.5
STOP_LOSS_MAX_PCT=8
ATR_MULT=1.5
TRAILING_STOP_PCT=3
TRAILING_MIN_PCT=2
TRAILING_MAX_PCT=8
TAKE_PROFIT_PCT=
ENTRY_TRIGGER_PCT=0.3
ENTRY_MAX_OFFSET_PCT=1
ENTRY_ORDER_TTL_MIN=30
EXIT_LIMIT_PCT=0.5
EARNINGS_BLACKOUT_DAYS=3

# --- Claude (Agent SDK uses your Max subscription via OAuth) ---
# Path the SDK's auth token persists at on the deploy host.
CLAUDE_AUTH_DIR=./claude-auth
CLAUDE_MODEL=claude-sonnet-4-6

# --- Congressional trade signal ---
# 'stockwatcher' | 'capitoltrades' | 'quiver'
CONGRESS_SIGNAL_PROVIDER=stockwatcher
CONGRESS_LOOKBACK_DAYS=30
CONGRESS_MAX_TRADES_PER_SYMBOL=5
# Drop spouse/trust/advisor filings on ingestion (~40-60% of raw filings)
CONGRESS_REQUIRE_OWN_TRADE=true
# Drop trades whose max-amount range falls below this (~50% of raw filings)
CONGRESS_MIN_AMOUNT_USD=50000
# Drop disclosures older than this many days (informational decay)
CONGRESS_MAX_AGE_DAYS=14
# Window for the "cluster trade" boost (multiple filers same ticker)
CLUSTER_WINDOW_DAYS=7
QUIVER_API_KEY=

# --- Alpaca News (Benzinga) ---
ALPACA_NEWS_ENABLED=false
NEWS_LOOKBACK_HOURS=24
NEWS_MAX_ITEMS_PER_SYMBOL=3
# Comma-separated subset of: earnings,guidance,m_and_a,regulatory,exec_change,analyst,recap,political_shock,other
NEWS_CATEGORIES_ALLOWED=earnings,guidance,m_and_a,regulatory,exec_change,political_shock
NEWS_CLASSIFIER_MODEL=claude-haiku-4-5-20251001

# --- TACO-trade dip-recovery strategy (iter3) ---
# Kill switch. Default off so iter3 lands inert; opt in once paper-tested.
DIP_STRATEGY_ENABLED=false
# Min peak-to-trough drawdown (%) to flag a dip event
DIP_DRAWDOWN_THRESHOLD_PCT=4
# Trailing window (days) for drawdown computation
DIP_DETECTION_WINDOW_DAYS=5
# Calendar days of patience before time-based bailout
DIP_RECOVERY_WINDOW_DAYS=14
# Exit when this fraction of the drawdown has been recovered toward peak (0.8 = 80% retrace)
DIP_TARGET_RECOVERY_PCT=0.8
# Require a political_shock news item in lookback window before opening a dip play
DIP_REQUIRES_POLITICAL_NEWS=true
# Capital reserved for dip plays (separate from MAX_POSITION_USD)
DIP_BUDGET_USD=800
# Consecutive higher-close daily bars required since trough before entry
DIP_REBOUND_CONFIRMATION_BARS=2
# Symbols the dip strategy can trade (indices only by default)
DIP_SYMBOLS=SPY,QQQ

# --- Prompt versioning (recorded on every decision row for cohort analysis) ---
PROMPT_VERSION=v2

# --- Misc ---
LOG_LEVEL=info
# If true, all orders are dry-run regardless of TRADING_MODE
SAFE_MODE=false
