# --- Alpaca ---
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
# 'paper' | 'live'
TRADING_MODE=paper
# Required to actually flip live mode on; defense-in-depth against accidents.
LIVE_TRADING_CONFIRMED=

# --- Single-user auth for the bot's mutating API routes ---
BOT_TOKEN=

# --- Cycle scheduling ---
# US/Eastern; default = every 15 min, market hours, weekdays.
CRON_SCHEDULE=*/15 9-16 * * 1-5
CRON_TZ=America/New_York

# --- DB path ---
SQLITE_PATH=./data/gainz.db

# --- Guardrails ---
SYMBOL_ALLOWLIST=AAPL,MSFT,NVDA,GOOGL,AMZN,META,TSLA,AMD,AVGO,JPM
MAX_POSITION_USD=2000
MAX_ORDER_USD=1000
MAX_DAILY_LOSS_USD=500
MAX_TRADES_PER_DAY=10

# --- Strategy ---
STOP_LOSS_PCT=2.5
STOP_LOSS_MIN_PCT=1.5
STOP_LOSS_MAX_PCT=8
ATR_MULT=1.5
TRAILING_STOP_PCT=3
TRAILING_MIN_PCT=2
TRAILING_MAX_PCT=8
TAKE_PROFIT_PCT=
ENTRY_TRIGGER_PCT=0.3
ENTRY_MAX_OFFSET_PCT=1
ENTRY_ORDER_TTL_MIN=30
EXIT_LIMIT_PCT=0.5
EARNINGS_BLACKOUT_DAYS=3

# --- Claude (Agent SDK uses your Max subscription via OAuth) ---
# Path the SDK's auth token persists at on the deploy host.
CLAUDE_AUTH_DIR=./claude-auth
CLAUDE_MODEL=claude-sonnet-4-6

# --- Congressional trade signal ---
# 'stockwatcher' | 'capitoltrades' | 'quiver'
CONGRESS_SIGNAL_PROVIDER=stockwatcher
CONGRESS_LOOKBACK_DAYS=30
CONGRESS_MAX_TRADES_PER_SYMBOL=5
QUIVER_API_KEY=

# --- Misc ---
LOG_LEVEL=info
# If true, all orders are dry-run regardless of TRADING_MODE
SAFE_MODE=false
